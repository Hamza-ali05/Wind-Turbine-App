# Environment (copy to .env and fill in)
# NASA POWER API
NASA_POWER_BASE_URL=https://power.larc.nasa.gov
# OpenRouteService
OPENROUTESERVICE_API_KEY=
# OpenStreetMap Overpass
OSM_OVERPASS_URL=https://overpass.kumi.systems/api/interpreter
# Comma-separated browser origins allowed to call this API
BACKEND_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# SQLite by default; swap for PostGIS later, e.g. postgresql+psycopg2://user:pass@localhost:5432/wind
DATABASE_URL=sqlite:///./data/app.db
# OpenTopography Global DEM (SRTM GL1 / ALOS AW3D30). Optional fallback if the elevation package cannot run.
OPENTOPOGRAPHY_API_KEY=
# ESA WorldCover 10 m (2021) COG tiles — public, no key required
ESA_WORLDCOVER_BASE_URL=https://esa-worldcover.s3.eu-central-1.amazonaws.com/v200/2021/map
# Optional Copernicus Land Monitoring WCS/WMS/COG URL (placeholders: {west} {south} {east} {north})
COPERNICUS_LANDCOVER_WCS_URL=
COPERNICUS_LANDCOVER_URL=
# Bearer token if the Copernicus URL requires authentication
COPERNICUS_API_KEY=
